{
  "manifest_version": 3,
  "name": "Passgen Plus",
  "version": "1.0.2",
  "description": "Strong password, passphrase, PIN and token generator. Click the icon to copy your default password.",
  "browser_specific_settings": {
    "gecko": {
      "id": "passgen@mithsys.xyz",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Passgen Plus: click to copy a new password",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "clipboardWrite", "clipboardRead", "contextMenus", "activeTab", "scripting"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+P"},
      "description": "Copy a new password"
    },
    "open-options": {
      "suggested_key": {"default": "Alt+Shift+G"},
      "description": "Open Passgen Plus options"
    }
  }
}
